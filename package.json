{
  "name": "optbrew",
  "version": "0.1.0",
  "type": "module",
  "description": "Pinned search audit and improvement skill bundle",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "optbrew": "bin/optbrew.mjs" },
  "files": [
    "bin/",
    "lib/",
    "skills/optbrew/",
    "plugin.json",
    ".codex-plugin/",
    ".claude-plugin/",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "test": "node --test",
    "build-bundle": "node scripts/build-bundle.mjs --bundle skills/optbrew --version 0.1.0",
    "vendor": "node scripts/vendor.mjs",
    "scan-secrets": "node scripts/scan-secrets.mjs --tracked-and-staged"
  }
}
