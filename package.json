{
  "name": "optbrew",
  "version": "0.1.4",
  "type": "module",
  "description": "Pinned search audit and improvement skill bundle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowwcastle-sudo/optbrew.git"
  },
  "homepage": "https://github.com/nowwcastle-sudo/optbrew#readme",
  "bugs": {
    "url": "https://github.com/nowwcastle-sudo/optbrew/issues"
  },
  "keywords": [
    "pi-package",
    "seo",
    "agent-skill"
  ],
  "pi": {
    "skills": [
      "./skills/optbrew"
    ]
  },
  "engines": {
    "node": ">=22.4"
  },
  "bin": {
    "optbrew": "bin/optbrew.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/optbrew/",
    "skills/.claude-plugin/",
    "skills/README.md",
    "plugin.json",
    ".codex-plugin/",
    ".claude-plugin/",
    "README.md",
    "README.ko.md",
    "AGENT_INSTALL.md",
    "CHANGELOG.md",
    "docs/platforms.md",
    "docs/release.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "source-lock.json",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/evals/**",
    "!**/tests/**",
    "!**/test_*.py"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "build-bundle": "node scripts/build-bundle.mjs --bundle skills/optbrew",
    "vendor": "node scripts/vendor.mjs",
    "scan-secrets": "node scripts/scan-secrets.mjs --tracked-and-staged"
  }
}
